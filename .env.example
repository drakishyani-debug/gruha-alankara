# Copy this file to .env and adjust as needed.
# app.py currently reads config from config.py / environment variables
# directly; python-dotenv is included so you can wire this up with
# `from dotenv import load_dotenv; load_dotenv()` in app.py if you prefer
# managing secrets this way.

GRUHA_SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
